STACKHOST_APP_ENV=development
STACKHOST_HTTP_ADDR=:8080
STACKHOST_DATA_DIR=./data
STACKHOST_SESSION_SECRET=replace-with-a-long-random-secret
STACKHOST_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
STACKHOST_COOKIE_SECURE=false
STACKHOST_DOCKER_HOST=unix:///var/run/docker.sock
STACKHOST_ALLOWED_ORIGIN=http://localhost:5173
STACKHOST_INGRESS_ENABLED=false
STACKHOST_INGRESS_HTTP_ADDR=:80
STACKHOST_INGRESS_HTTPS_ADDR=:443
STACKHOST_ACME_EMAIL=
STACKHOST_CERT_STORAGE=./data/certificates
STACKHOST_PUBLIC_ADDRESSES=
